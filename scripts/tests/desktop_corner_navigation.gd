extends "res://scripts/tests/desktop_discovery.gd"

func hover_at(point: Vector2) -> void:
	var event := InputEventMouseMotion.new()
	event.position = point
	event.global_position = point
	root.push_input(event, true)

func _run() -> void:
	create_timer(100).timeout.connect(func(): quit(1))
	OS.set_environment("IDLE_ELITE_DESKTOP", "1")
	OS.set_environment("IDLE_ELITE_DISABLE_ONLINE_REQUESTS", "1")
	OS.set_environment("IDLE_ELITE_DISABLE_SAVE_WRITES", "1")
	OS.set_environment("IDLE_ELITE_HEADLESS_BOOT_SMOKE", "1")
	OS.set_environment("IDLE_ELITE_HEADLESS_BOOT_SMOKE_SECONDS", "90")
	AudioServer.set_bus_mute(0, true)
	root.size = Vector2i(1920, 1080)
	game = load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	OS.set_environment("IDLE_ELITE_HEADLESS_BOOT_SMOKE", "0")
	for frame in range(1600):
		await settle(0.02)
		if game.startup_initialized and not game._boot_warmup_runtime().active: break
	game._test_state_runtime()._god_mode_unlock_onboarding_state()
	game._tutorial_overlay_surface()._update_tutorial_overlay()
	game._tutorial_overlay_surface()._dismiss_blocking_tip()
	game.desktop_layout.restore_preferences({})
	game.desktop_layout.rotate_slots("fishing")
	game.selected_skill_id = "fight"
	await game._navigation_shell()._render_screen()
	await hover_at(Vector2(900, 700))
	await settle(2)
	var nav = game.desktop_layout.skill_navigation
	check(nav.previous.modulate.a == 0 and nav.next.modulate.a == 0, "Full buttons hidden at rest")
	check(game.skills_page.offset_bottom == -game.desktop_layout.RIBBON_HEIGHT, "Navigation reserves no permanent gameplay row")
	await capture_desktop("corner-before")
	await hover_at(nav.corner_rect(0).get_center())
	await settle(0.20)
	await capture_desktop("corner-transition")
	await settle(0.35)
	check(nav.previous.modulate.a > 0.99 and nav.next.modulate.a == 0, "Only hovered corner reveals")
	check(nav.previous.get_global_rect().position.x >= 0, "Left button entirely inside gameplay")
	await capture_desktop("corner-open")
	await click(nav.previous.get_global_rect().get_center())
	await settle(0.5)
	check(game.desktop_layout.skill_slots == ["woodcutting", "fishing", "fight"], "Revealed left button moves carousel")
	await hover_at(Vector2(900, 700))
	await settle(0.3)
	check(nav.previous.modulate.a > 0.5, "Short departure does not flicker closed")
	await settle(0.8)
	check(nav.previous.modulate.a == 0, "Mouse activation does not leave button focused open")
	await hover_at(nav.corner_rect(1).get_center())
	await settle(0.5)
	await capture_desktop("corner-right")
	check(nav.next.get_global_rect().end.x <= game.desktop_layout.gameplay_width(), "Right button entirely inside gameplay")
	await click(nav.next.get_global_rect().get_center())
	await settle(0.5)
	check(game.desktop_layout.skill_slots == ["fishing", "fight", "thieving"], "Revealed right button moves carousel")
	await hover_at(Vector2(900, 700))
	await settle(1)
	nav.previous.grab_focus()
	await settle(0.4)
	check(nav.previous.modulate.a > 0.99, "Keyboard focus reveals button")
	nav.previous.release_focus()
	await settle(1)
	var old_slots: Array = game.desktop_layout.skill_slots.duplicate()
	for pressed in [true, false]:
		var touch := InputEventScreenTouch.new()
		touch.index = 4
		touch.position = nav.corner_rect(1).get_center()
		touch.pressed = pressed
		root.push_input(touch, true)
		await settle(0.05)
	await settle(0.4)
	check(nav.next.modulate.a > 0.99 and game.desktop_layout.skill_slots == old_slots, "First touch reveals without accidental navigation")
	await settle(3)
	await capture_desktop("corner-settled")
	check(nav.next.modulate.a == 0, "Touch reveal expires")
	root.size = Vector2i(1080, 1920)
	await settle(1.5)
	game._navigation_shell()._select_skill("fight")
	await settle(1.0)
	await capture_desktop("corner-padlock-portrait")
	check(not nav.visible, "Corner controls absent in portrait")
	print("CORNER_NAV failures=", JSON.stringify(failures))
	game._app_lifecycle_runtime()._prepare_for_shutdown()
	game.queue_free()
	await process_frame
	quit(0 if failures.is_empty() else 1)
