extends "res://scripts/tests/action_art_oct22.gd"

func audit_action_art() -> void:
	if game._halloween_runtime().greeting_visible():
		await click(Vector2(540, 950), true)
		await settle(0.3)
	var onboarding = game._onboarding_runtime()
	onboarding.soft_interactions_seen.clear()
	game.material_runtime.set_amount("scrapwood", 0)
	await open_notes_skill("woodcutting")
	var card := await notes_card("firepit")
	await align_notes_card(card)
	var arrow: Control = card.art_root.get_node("SoftTutorialArrow")
	check(arrow.is_visible_in_tree(), "Unfamiliar unlocked firepit shows a soft arrow")
	check(arrow.mouse_filter == Control.MOUSE_FILTER_IGNORE, "Arrow never captures taps")
	check(not game._tutorial_overlay_surface().blocking_tip_active, "Firepit guidance is nonblocking")
	await capture("firepit-before")
	await settle(0.6)
	await capture("firepit-arrow-motion")
	# An actual modal hides the local cue, then restores it without acknowledging it.
	game.settings_overlay = Control.new()
	game.add_child(game.settings_overlay)
	await settle(0.1)
	check(not arrow.visible, "Modal hides the cue")
	game.settings_overlay.queue_free()
	game.settings_overlay = null
	await settle(0.3)
	check(arrow.visible, "Dismissing modal restores unseen cue")
	var saved_scroll: int = game.detail_actions_scroll.scroll_vertical
	game.detail_actions_scroll.scroll_vertical = game.detail_actions_scroll.get_max_scroll_vertical()
	await settle(0.3)
	if is_instance_valid(arrow): check(not arrow.is_visible_in_tree() or not arrow.visible, "Offscreen cue is hidden")
	game.detail_actions_scroll.scroll_vertical = saved_scroll
	await settle(0.5)
	card = await notes_card("firepit")
	await align_notes_card(card)
	await click(card.toggle.get_global_rect().get_center(), true)
	await settle(0.12)
	check(game.last_result == "You need one scrap wood to light the fire.", "Empty firepit explains its exact cost")
	check(onboarding.soft_interactions_seen.has("firepit"), "Real tap acknowledges firepit cue")
	check(not game._passive_modules_runtime().firepit_active(game._unix_now()), "No fuel cannot light the fire")
	await capture("firepit-no-wood")
	await settle(1.1)
	game.material_runtime.set_amount("scrapwood", 3)
	await click(card.toggle.get_global_rect().get_center(), true)
	await settle(1.4)
	check(game._passive_modules_runtime().firepit_active(game._unix_now()), "Real tap still lights the fire with wood")
	await capture("firepit-lit")
	await open_notes_skill("thieving")
	var jailed := await notes_card("borrow-cookie-permanently")
	await align_notes_card(jailed)
	var surface = game._thieving_surface()
	# Test all ordinary activities at the four/five-level boundary, independent of save level.
	for action in game.actions_by_skill.thieving:
		var level := int(action.get("unlock", 1))
		check(surface._thieving_action_jail_seconds(action, level + 4) > 0, "Below immunity boundary: " + str(action.id))
		check(surface._thieving_action_jail_seconds(action, level + 5) == 0, "Five levels above prevents jail: " + str(action.id))
	surface._jail_thieving_action("borrow-cookie-permanently", false, 60)
	await settle(0.7)
	jailed = game.action_cards[game._action_key("thieving", "borrow-cookie-permanently")]
	var overlay: Control = jailed.jail_overlay
	var hint: Control = overlay.get_node("JailTapHint")
	check(hint.visible, "First jail shows a soft arrow")
	await capture("jail-before")
	var until_before := int(game.thieving_state.action_jails["borrow-cookie-permanently"].cooldown_until_unix)
	await click(overlay.get_global_rect().get_center(), true)
	await settle(0.12)
	var until_after := int(game.thieving_state.action_jails["borrow-cookie-permanently"].cooldown_until_unix)
	check(until_after == until_before - 1, "One real jail tap removes exactly one second")
	var popup: Control = overlay.get_node_or_null("JailTimerReduction")
	check(popup != null and popup.visible and popup.z_as_relative and popup.z_index > 6, "Minus-one feedback renders above jail bars and timer")
	check(onboarding.soft_interactions_seen.has("jail") and not hint.visible, "First jail tap dismisses cue")
	await capture("jail-tap-feedback")
	await settle(1.2)
	await capture("jail-after")
	var payload: Dictionary = game._save_runtime()._save_payload(game._unix_now())
	onboarding.soft_interactions_seen.clear()
	game._save_runtime()._restore_tip_metadata_from_save(payload)
	check(onboarding.soft_interactions_seen == {"firepit": true, "jail": true}, "Learned interactions survive save serialization/restoration")
	game._save_runtime()._restore_tip_metadata_from_save({"soft_interactions_seen": {"firepit": "false", "jail": false, "unknown": true}})
	check(onboarding.soft_interactions_seen.is_empty(), "Malformed/unknown cue flags cannot dismiss tutorials")
	game._save_runtime()._restore_tip_metadata_from_save(payload)
	surface._clear_thieving_action_jail("borrow-cookie-permanently", false)
	await open_notes_skill("woodcutting")
	card = await notes_card("firepit")
	await align_notes_card(card)
	check(not card.art_root.get_node("SoftTutorialArrow").visible, "Rebuilt card preserves acknowledged cue state")
	print("SOFT_INTERACTION_GUIDANCE failures=", JSON.stringify(failures))
	var report := FileAccess.open(capture_dir + "/result.json", FileAccess.WRITE)
	report.store_string(JSON.stringify({"failures": failures}))
	report.close()
	game._app_lifecycle_runtime()._prepare_for_shutdown()
	game.queue_free()
	await process_frame
	quit(0 if failures.is_empty() else 1)
