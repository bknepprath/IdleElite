extends "res://scripts/tests/action_art_oct22.gd"

func audit_action_art() -> void:
	var runtime=game._grove_runtime()
	runtime.reset()
	for id in runtime.IDS:
		check(int(runtime.arena_upgrade_cost(id,"capacity").amount)==40,"First additional tree costs 40 wood: "+id)
		check(is_equal_approx(float(runtime.rules(id).regrowth_speed_per_level),.1),"All groves use the reduced growth-speed bonus: "+id)
	await open_notes_skill("woodcutting")
	var card:=await notes_card("grove-birch")
	if card.is_empty(): quit(1); return
	await align_notes_card(card)
	var stage: Control=card.grove_stage
	game.material_runtime.set_amount("softwood",39)
	await settle(.4)
	check(stage.arena_buttons[0].disabled,"Capacity cannot be purchased for the old lower price")
	check(not runtime.buy_arena_upgrade("grove-birch","capacity"),"Insufficient wood does not buy a tree")
	check(game.material_runtime.amount("softwood")==39,"Rejected purchase spends no wood")
	game.material_runtime.set_amount("softwood",1000)
	await settle(.4)
	await capture("new-base-prices")
	await click(stage.arena_buttons[0].get_global_rect().get_center(),true)
	await settle(.4)
	check(game.material_runtime.amount("softwood")==960,"Real Capacity tap spends exactly 40 wood")
	check(runtime.tree_capacity("grove-birch")==3,"Capacity still adds one tree")
	check(int(runtime.arena_upgrade_cost("grove-birch","capacity").amount)==160,"Second Capacity upgrade costs 160 wood")
	await click(stage.arena_buttons[1].get_global_rect().get_center(),true)
	await settle(.4)
	check(is_equal_approx(runtime.regrowth_seconds("grove-birch"),20.0/1.1),"First Spawn upgrade gives 18.18 second regrowth")
	check(game.material_runtime.amount("softwood")==945,"Spawn upgrade retains its 15 wood price")
	await capture("first-capacity-and-spawn-upgrades")
	for level in range(2,6):
		await click(stage.arena_buttons[1].get_global_rect().get_center(),true)
		await settle(.4)
		check(int(runtime.arena_levels("grove-birch").regrowth)==level,"Real Spawn tap buys level "+str(level))
	check(is_equal_approx(runtime.regrowth_seconds("grove-birch"),20.0/1.5),"Maximum Spawn upgrade now gives 13.33 second regrowth")
	check(stage.arena_buttons[1].disabled,"Spawn cap prevents additional purchases")
	await capture("maximum-spawn-upgrade")
	var saved: Dictionary=runtime.for_save()
	runtime.restore(JSON.parse_string(JSON.stringify(saved)))
	check(runtime.tree_capacity("grove-birch")==3 and int(runtime.arena_levels("grove-birch").regrowth)==5,"Existing purchased upgrade levels survive restoring")
	check(is_equal_approx(runtime.regrowth_seconds("grove-birch"),20.0/1.5),"Restored upgrades use the reduced growth bonus")
	print("GROVE_BALANCE failures=",JSON.stringify(failures))
	var result:=FileAccess.open(capture_dir+"/result.json",FileAccess.WRITE)
	result.store_string(JSON.stringify({"failures":failures}))
	result.close()
	game._app_lifecycle_runtime()._prepare_for_shutdown()
	quit(0 if failures.is_empty() else 1)
