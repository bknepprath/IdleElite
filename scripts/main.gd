		anchor = hub_tab
	if anchor != null and is_instance_valid(anchor) and anchor.is_visible_in_tree():
		_float_reward(self, anchor, HUB_LOCKED_MESSAGE, 50, Color("#ffd95a"), Vector2(0, -34), Vector2(0, -150), 0.0)


