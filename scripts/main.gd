func _fishing_tool_xp_multiplier() -> float:
	match equipped_fishing_tool_id:
		"line":
			return FISHING_ROD_XP_MULT
		"reinforced_rod":
			return FISHING_REINFORCED_ROD_XP_MULT
		"star_rod":
			return FISHING_STAR_ROD_XP_MULT
		"mirror":
			return FISHING_REFLECT_NET_XP_MULT
