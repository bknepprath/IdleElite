func _fishing_tool_yield_bonus() -> int:
	return 0


func _fishing_wallet_choice_tools() -> Array:
	var choices: Array = []
	for raw_tool in _fishing_visible_tool_defs():
		var tool := raw_tool as Dictionary
		var tool_id := str(tool.get("id", ""))
