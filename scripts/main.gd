func _texture_from_image(path: String, image: Image) -> Texture2D:
	if not _can_create_image_textures():
		texture_cache[_res_path(path)] = null
		return null
	var texture := _create_image_texture(image)
	texture_cache[_res_path(path)] = texture
	return texture


func _atlas_texture(path: String, region: Rect2, filter_clip := false) -> Texture2D:
	var normalized := _res_path(path)
	var cache_key := "%s|atlas|%.3f,%.3f,%.3f,%.3f|%s" % [
		normalized,
		region.position.x,
		region.position.y,
		region.size.x,
		region.size.y,
		str(filter_clip)
	]
	if atlas_texture_cache.has(cache_key):
		return atlas_texture_cache[cache_key] as Texture2D
	var source := _texture(normalized)
	if source == null:
		atlas_texture_cache[cache_key] = null
		return null
	var atlas := AtlasTexture.new()
	atlas.atlas = source
	atlas.region = region
	atlas.filter_clip = filter_clip
	atlas_texture_cache[cache_key] = atlas
	return atlas


func _image(path: String, minimum_size: Vector2) -> TextureRect:
	var image := TextureRect.new()
	image.texture = _texture_or_visual_fallback(path)
	image.custom_minimum_size = minimum_size
	image.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	image.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	image.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return image


func _spritesheet_texture(path: String, index: int, cell_size: Vector2) -> Texture2D:
	return _atlas_texture(path, Rect2(Vector2(maxi(0, index) * cell_size.x, 0), cell_size))


func _spritesheet_or_visual_fallback(path: String, index: int, cell_size: Vector2) -> Texture2D:
	var loaded_texture := _spritesheet_texture(path, index, cell_size)
	return loaded_texture if loaded_texture != null else _visual_fallback_texture()


