			"stat_hit_buttons": stat_hit_buttons,
			"bonus_panel": bonus_panel,
			"status": status,
			"medal": medal,
			"mastery": mastery_progress,
			"progress": progress,
			"fluid_strip": fluid_strip,
			"border": border,
			"mission_badge": mission_badge["root"],
