		"firepit_glow": active_dim,
		"status_panel": status_panel,
		"flame_fx": flame_fx,
		"status": status_label,
		"timer": timer_label,
		"buff": buff_label,
		"toggle": toggle_button,
		"progress": fuel_ring,
		"border": border,
