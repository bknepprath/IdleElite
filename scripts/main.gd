func _fishing_rod_upgrade_cost(tool_id: String) -> int:
	return FISHING_STAR_ROD_COST if tool_id == "star_rod" else FISHING_REINFORCED_ROD_COST


func _fishing_rod_upgrade_title(tool_id: String) -> String:
