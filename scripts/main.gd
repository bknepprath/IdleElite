			continue
		var entry_data := entry as Dictionary
		if str(entry_data.get("kind", "")) == "thieving_heist":
			var heist := entry_data.get("heist", {}) as Dictionary
			var heist_root := _build_thieving_heist_card(heist, actions_width)
