		return
	var bob := sin(value * TAU * 2.0) * 10.0
	var sway := sin(value * TAU * 1.35 + 0.7) * 8.0
	flyer.position = start_position + Vector2(sway, bob)
	flyer.rotation = sin(value * TAU * 1.6) * 0.075


