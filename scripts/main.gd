func _success_chance(skill_id: String, action: Dictionary) -> float:
	if _is_convergence_action(action):
		return 100.0
	var cache_key := _action_stat_value_cache_key("success", skill_id, action)
	if action_stat_value_cache.has(cache_key):
		return float(action_stat_value_cache[cache_key])
	var value := 100.0
	if _fishing_rework_active_for_skill(skill_id) and not _is_event_action(action):
		value = clampf(_fishing_attempt_success_chance(str(action.get("id", ""))) + _activity_medal_accuracy_bonus(skill_id, action), 5.0, 100.0)
	else:
		var base_success := float(action.get("success", 90.0))
		var medal_success := _global_reward_bonus("success_bonus", skill_id) + _activity_medal_rate_bonus(skill_id, action)
		var success_before_barn := clampf(base_success + medal_success, 5.0, 100.0)
		var barn_bonus := (100.0 - success_before_barn) * _hub_barn_failure_factor()
		value = clampf(success_before_barn + barn_bonus + _hub_trophy_success_bonus() * 100.0, 5.0, 100.0)
	action_stat_value_cache[cache_key] = value
	return value


func _roll_action_success(skill_id: String, action: Dictionary) -> bool:
	if _consume_guaranteed_success_action_completion(skill_id, action):
		return true
	return randf() * 100.0 <= _success_chance(skill_id, action)


func _consume_guaranteed_success_action_completion(skill_id: String, action: Dictionary) -> bool:
	if skill_id.is_empty() or action.is_empty() or _is_passive_action(action) or _is_convergence_action(action):
		return false
	if guaranteed_success_action_completions >= GUARANTEED_SUCCESS_ACTION_COMPLETIONS:
		return false
	guaranteed_success_action_completions += 1
	_mark_save_dirty("starter guaranteed success")
	return true


func _activity_crit_chance(streak_bonus: bool) -> float:
	var base_chance := ACTIVITY_STREAK_CRIT_CHANCE if streak_bonus else ACTIVITY_NORMAL_CRIT_CHANCE
	var bonus_mult := AchievementState.reward_bonus(_achievement_milestones(), "crit_chance_mult")
	return clampf(base_chance * (1.0 + bonus_mult), 0.0, 1.0)


