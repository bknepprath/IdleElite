			"icon_size": Vector2(286, 286),
			"count_position": Vector2(20, 72),
			"slots": [
				Vector2(-112, 238), Vector2(-32, 246), Vector2(48, 238), Vector2(128, 246),
				Vector2(-72, 184), Vector2(8, 174), Vector2(88, 184),
