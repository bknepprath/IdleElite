	var prefix := "%s:%s:" % [skill_id, action_id]
	for raw_key in manual_activity_requirement_unlocks.keys():
		var key := str(raw_key)
		if key.begins_with(prefix):
			manual_activity_requirement_unlocks.erase(raw_key)


