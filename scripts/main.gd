	var padlock_shadow := TextureRect.new()
	padlock_shadow.texture = padlock_texture
	padlock_shadow.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	padlock_shadow.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
