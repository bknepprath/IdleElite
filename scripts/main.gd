		return


func _boot_warmup_texture_paths() -> Array:
	var paths := _boot_shared_texture_paths()
	_add_boot_warmup_texture_path(paths, AchievementRewards.TOTAL_LEVEL_ART)
	_add_boot_warmup_texture_path(paths, AchievementRewards.CRIT_ART)
	_add_boot_warmup_texture_path(paths, AchievementRewards.CREDIT_ART)
	_add_boot_warmup_texture_path(paths, AchievementRewards.CUMULATIVE_MEDALS_ART)
	_add_boot_warmup_texture_path(paths, LOG_CURRENCY_ICON_TEXTURE)
	_add_boot_warmup_texture_path(paths, PLANK_ICON_TEXTURE)
	_add_boot_warmup_texture_path(paths, UPGRADE_ARROW_ICON_TEXTURE)
	var warmup_skill_ids := _boot_warmup_skill_ids()
	if warmup_skill_ids.has("fishing"):
		_add_boot_warmup_texture_path(paths, FISH_CURRENCY_ICON_TEXTURE)
		_add_fishing_boot_warmup_texture_paths(paths)
	for skill_id in warmup_skill_ids:
		_add_boot_warmup_texture_path(paths, _skill_icon_path(skill_id))
		if skill_id == "thieving":
			_add_boot_warmup_texture_path(paths, THIEVING_HEIST_BACKGROUND_SHEET)
			_add_boot_warmup_texture_path(paths, THIEVING_HEIST_TROPHY_SHEET)
			_add_boot_warmup_texture_path(paths, THIEVING_HEIST_JAIL_BARS_TEXTURE)
		for action in _visible_actions_for_skill(skill_id):
			var action_data := action as Dictionary
			_add_boot_warmup_texture_path(paths, str(action_data.get("art", "")))
			_add_boot_warmup_texture_path(paths, str(action_data.get("bg", "")))
			if skill_id == "fishing":
				var action_id := str(action_data.get("id", ""))
				if FISHING_ACTION_CATCH_TEXTURE_PATHS.has(action_id):
					_add_boot_warmup_texture_path(paths, FISHING_ACTION_CATCH_TEXTURE_PATHS[action_id])
	return paths


func _uncached_boot_warmup_texture_paths() -> Array:
	return _uncached_texture_paths(_boot_warmup_texture_paths())


func _add_fishing_boot_warmup_texture_paths(paths: Array) -> void:
	for tool in FISHING_TOOL_DEFS:
		_add_boot_warmup_texture_path(paths, str((tool as Dictionary).get("art", "")))
	_add_fishing_detail_visual_texture_paths(paths)


func _add_fishing_detail_visual_texture_paths(paths: Array) -> void:
	_add_boot_warmup_texture_path(paths, FISH_CURRENCY_ICON_TEXTURE)
	_add_boot_warmup_texture_path(paths, FISHING_LOCATION_THUMBNAIL_SHEET)
	for raw_area in _fishing_area_definitions():
		var area_def := raw_area as Dictionary
		var area_bg_path := str(area_def.get("bg", ""))
		if str(area_def.get("id", "")) == "beach" and ResourceLoader.exists("res://assets/content/fishing/backgrounds/beach-rocky-zoom.png"):
			area_bg_path = "res://assets/content/fishing/backgrounds/beach-rocky-zoom.png"
		_add_boot_warmup_texture_path(paths, area_bg_path)
		var area_id := str(area_def.get("id", ""))
		if _fishing_area_uses_location_tiles(area_def):
			for raw_location in _fishing_locations_for_area(area_id):
				var location := raw_location as Dictionary
				_add_boot_warmup_texture_path(paths, _fishing_location_thumbnail_path(area_id, str(location.get("id", ""))))
	for raw_tool in FISHING_TOOL_DEFS:
		var tool := raw_tool as Dictionary
		_add_boot_warmup_texture_path(paths, str(tool.get("art", "")))
	for raw_catch_path in FISHING_ACTION_CATCH_TEXTURE_PATHS.values():
		_add_boot_warmup_texture_path(paths, str(raw_catch_path))


func _boot_warmup_skill_ids() -> Array:
