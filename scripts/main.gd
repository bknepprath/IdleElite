		return
	_kill_meta_tween(module_utility_row, "skill_swipe_module_utility_fade_tween")
	var target_alpha := 1.0 if visible else 0.0
	if seconds <= 0.001:
		_set_skill_swipe_module_utility_alpha(target_alpha)
