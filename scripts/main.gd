func _ensure_nav_bar_icons() -> void:
	for button in [hero_tab, hub_tab, skills_tab, settings_tab, shop_tab]:
		if button == null or not is_instance_valid(button):
			continue
		var path := str(button.get_meta("deferred_icon_path", ""))
