func _play_bonus_jingle() -> void:
	if not _can_play_audio():
		return
	_play_with_pitch(bonus_jingle_player, 1.18)
	var tween := create_tween()
	tween.tween_interval(ACTIVITY_BONUS_JINGLE_DELAY)
