		progress.anchor_right = 1.0
		progress.anchor_top = 1.0
		progress.anchor_bottom = 1.0
		progress.offset_left = ACTION_PROGRESS_RAIL_INSET
		progress.offset_right = -ACTION_PROGRESS_RAIL_INSET
