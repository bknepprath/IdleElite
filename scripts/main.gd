		_play(success_players[pitch_index])
	if streak_bonus:
		_play_bonus_jingle()
	elif medal_unlocked:
		_play(medal_player)


func _play_activity_crit_sound(streak_step: int, mega_crit := false, crit_chain_count := 0) -> void:
